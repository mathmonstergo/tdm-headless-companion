    time_display = f"{cst_time_str}{ago_str}" if cst_time_str else "-"

    return gname, full_name, time_display

def render_cli(statuses: list[dict], show_history: bool = False):
    sep = "─" * 74
    lines = []
    lines.append(f"┌{sep}┐")
    current_time_str = datetime.now(CST).strftime("%H:%M:%S")
    title = f" Twitch Drops Miner 挂机与掉宝总览 (北京时间 {current_time_str}) "
    lines.append(f"│{title.center(70)}│")
    lines.append(f"├{sep}┤")

    if not statuses:
        lines.append("│ 未找到运行中的 Twitch Drops Miner 实例。".ljust(72) + "│")
        lines.append(f"└{sep}┘")
        return "\n".join(lines)

    for i, s in enumerate(statuses):
        run_badge = s.get("status_badge") or ("🟢 观看中" if s["running"] else "⚪ 已停止")
        svc_display = f" [{s['service']}]" if s['service'] != "-" else ""
        lines.append(f"│ 👤 {s['name']}{svc_display}  {run_badge}")
        lines.append(f"│   状态: {s['status_text']}")

        games = s.get("tracked_games") or []
        games_str = ", ".join(games) if games else "未配置(全部游戏)"
        mode_str = s.get("priority_mode") or "默认模式"
        lines.append(f"│   🎯 跟踪游戏: {games_str}")
        lines.append(f"│   ⚙️  挂机模式: {mode_str}")

        watching = s.get("watching")
        if watching:
            viewers_str = f" ({watching['viewers']:,} 观众)" if watching.get("viewers") else ""
            lines.append(f"│   📺 当前直播: {watching['name']}{viewers_str}")

        drop = s.get("drop")
        if drop and drop.get("game"):
            pct = drop.get("progress_percent", 0.0)
            cur = drop.get("current_minutes", 0)
            req = drop.get("required_minutes", 0)
            rem = drop.get("remaining_minutes", 0)
            bar = make_bar(pct, 20)
            lines.append(f"│   🎮 目标游戏: {drop.get('game')} | 活动: {drop.get('campaign', '-')}")
            lines.append(f"│   🎁 目标奖励: {drop.get('rewards', '-')}")
            lines.append(f"│   ⏳ 当前进度: [{bar}] {pct:.1f}% ({cur}/{req} 分钟, 剩 {rem} 分钟)")
        elif s["running"]:
            lines.append(f"│   ⏳ 当前进度: (当前无正在观看的掉落活动)")

        latest = s.get("latest_claim")
        if latest and latest.get("name"):
            _, full_name, time_display = format_claim_entry(latest)
            lines.append(f"│   🏆 最近领取: {full_name}")
            lines.append(f"│      领取时间: {time_display}")
        else:
            lines.append(f"│   🏆 最近领取: (暂无记录/尚未同步)")

        if show_history and s.get("recent_claims"):
            lines.append(f"│   📜 历史掉宝明细 (最近5条, 北京时间):")
            for item in s["recent_claims"]:
                _, full_name, time_display = format_claim_entry(item)
                lines.append(f"│      • [{time_display}] {full_name}")

        lines.append(f"│   ⏱️  状态同步: {s['updated_at']} (UTC+8)")

        if i < len(statuses) - 1:
            lines.append(f"├{sep}┤")

    lines.append(f"└{sep}┘")
    return "\n".join(lines)

def main():
    parser = argparse.ArgumentParser(description="Twitch Drops Miner 实时进度与掉宝记录查看器")
    parser.add_argument("-w", "--watch", action="store_true", help="实时动态刷新监控 (每 2 秒)")
    parser.add_argument("-c", "--claims", action="store_true", help="展开最近所有领取的历史掉宝明细")
    parser.add_argument("-j", "--json", action="store_true", help="以 JSON 格式输出")
    parser.add_argument("-d", "--dir", action="append", help="手动指定实例根目录路径 (可重复传入多个)")
    args = parser.parse_args()

    accounts = discover_accounts(args.dir)

    if args.json:
        results = [get_account_status(a) for a in accounts]
        print(json.dumps(results, ensure_ascii=False, indent=2))
        return

    if args.watch:
        try:
            while True:
                results = [get_account_status(a) for a in accounts]
                output = render_cli(results, show_history=args.claims)
                sys.stdout.write("\033[2J\033[H" + output + "\n按 Ctrl+C 退出监控...\n")
                sys.stdout.flush()
                time.sleep(2)
        except KeyboardInterrupt:
            print("\n已退出。")
            return
    else:
        results = [get_account_status(a) for a in accounts]
        print(render_cli(results, show_history=args.claims))

if __name__ == "__main__":
    main()
